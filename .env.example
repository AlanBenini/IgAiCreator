# Copia questo file in .env e valorizza solo le variabili che ti servono.
# Senza SUPABASE_URL/SUPABASE_ANON_KEY il workspace parte in modalità locale
# anonima e usa i post demo.

# Dati demo obbligatori finché non colleghi un account Meta reale.
USE_MOCK=True

# LLM compatibile OpenAI (Groq, Ollama, ...) usato per generare i copy.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Supabase: login Google, token Meta e token Google Calendar.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Instagram.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Firma HMAC dello state OAuth: obbligatoria per collegare Instagram.
SESSION_SECRET=

# Google Calendar: serve il client OAuth per rinnovare il token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token Meta globale di fallback (solo se non usi il collegamento per utente).
ACCESS_TOKEN=
IG_USER_ID=

# URL pubblico HTTPS usato da Meta per scaricare le immagini da pubblicare.
PUBLIC_BASE_URL=

# Vercel Blob; collega uno store Blob al progetto per valorizzare queste variabili.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Limiti upload del Content Studio.
MAX_UPLOADS=20
MAX_UPLOAD_BYTES=10485760

# Cache insights Meta in secondi (default 6 ore).
INSIGHTS_CACHE_TTL=21600

# Solo se il frontend è servito da un dominio diverso da questo backend.
CORS_ORIGINS=
